filters:
  and:
    - type == "case"
views:
  - type: table
    name: Pipeline
    order:
      - file.name
      - status
      - priority
      - pathway
      - outcome
      - founder_status
      - verification
      - geography
  - type: cards
    name: Board
    order:
      - status
      - outcome
      - pathway
      - priority
