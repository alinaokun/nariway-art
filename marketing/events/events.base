filters:
  and:
    - type == "event"
views:
  - type: table
    name: Events
    order:
      - file.name
      - date
      - category
      - location
      - cost
      - decision
      - deadline
    sort:
      - property: date
        direction: ASC
  - type: cards
    name: Board
    order:
      - date
      - category
      - decision
